<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub token lives in DataStore; it must never reach cloud
     backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
